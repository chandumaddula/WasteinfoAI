    <!-- Category Selection -->
    <string name="category_selection_title">உங்கள் பிரிவைத் தேர்ந்தெடுக்கவும்</string>
    <string name="category_selection_subtitle">கீழே உங்கள் சுயவிவரத்தைத் தேர்ந்தெடுக்கவும். தனிப்பயனாக்கப்பட்ட டாஷ்போர்டை உள்ளமைக்க ஒரு விருப்பத்தைத் தட்டவும்.</string>
    <string name="category_household_title">வீட்டு மறுசுழற்சி</string>
    <string name="category_household_desc">குடியிருப்பாளர்கள், குடியிருப்புகள், வீட்டுக் கழிவு பிரித்தல் &amp; வீட்டு வாசலில் வரிசைப்படுத்துதல்</string>
    <string name="category_ewaste_title">மின்-கழிவு மேலாண்மை</string>
    <string name="category_ewaste_desc">மின்னணுவியல், சர்க்யூட்டுகள், பேட்டரிகள், அபாயகரமான ஸ்கிராப் &amp; மின்-கழிவு மையங்கள்</string>
    <string name="category_community_title">சமூக மறுசுழற்சி</string>
    <string name="category_community_desc">வட்டார மையங்கள், உள்ளூர் மறுசுழற்சி இயக்கங்கள் &amp; சமூக சேகரிப்பு முயற்சிகள்</string>
    <string name="category_plastic_title">பிளாஸ்டிக் கழிவு குறைப்பு</string>
    <string name="category_plastic_desc">ஒருமுறை பயன்படுத்தும் பிளாஸ்டிக், பேக்கேஜிங் குறைப்பு &amp; வணிக மறுசுழற்சி</string>
    <string name="category_sustainability_title">நிலைத்தன்மை கல்வி</string>
    <string name="category_sustainability_desc">பள்ளிகள், கல்லூரிகள், பயிலரங்குகள் &amp; சுற்றுச்சூழல் விழிப்புணர்வு திட்டங்கள்</string>
