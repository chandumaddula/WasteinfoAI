# wasteinfoAI backend configuration.
# Copy to ".env" (same folder) and replace the placeholder values.
# NEVER commit the real .env file.

# --- Application ---------------------------------------------------------
APP_NAME=wasteinfoAI API
# development | testing | production
ENVIRONMENT=development
DEBUG=true
# Versioned API prefix
API_V1_PREFIX=/api/v1
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# JSON log lines (true) or human readable (false)
LOG_JSON=true

# --- PostgreSQL ----------------------------------------------------------
# Also read by the root docker-compose.yml (use: docker compose --env-file backend/.env ...)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wasteinfoai
POSTGRES_USER=wasteinfoai
POSTGRES_PASSWORD=change-me-local-dev-password

# Optional full URL; when set it overrides the POSTGRES_* values above.
# Must use the psycopg 3 driver:  postgresql+psycopg://USER:PASSWORD@HOST:5432/DB
# (special characters in the password must be URL-encoded)
# DATABASE_URL=

# Connection pool / timeouts
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5

# --- CORS ----------------------------------------------------------------
# Comma-separated list of exact origins. "*" is rejected in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=false
